# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env real (con credenciales) al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=America/Bogota

# Connection string de Supabase: Project Settings > Database > Connection string > URI
# (usa el modo "Session pooler" o "Transaction pooler" si despliegas en Render/serverless)
# Ejemplo:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# URL(es) del front-end (Vite + React) separadas por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL pública de este backend (para /admin/ en producción, p.ej. Render)
# Ejemplo: CSRF_TRUSTED_ORIGINS=https://tu-backend.onrender.com
CSRF_TRUSTED_ORIGINS=
